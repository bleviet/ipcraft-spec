{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ipcraft.dev/schemas/packet_format.schema.json",
  "title": "IPCraft Stream Packet Format",
  "description": "Packet formats of streaming interfaces (*.pkt.yml). See docs/packet_format_spec.md.",
  "type": "object",
  "additionalProperties": false,
  "patternProperties": { "^x-": {} },
  "required": ["pktVersion", "packetFormats"],
  "properties": {
    "pktVersion": { "type": "integer", "minimum": 1, "description": "Format version, currently 1" },
    "description": { "type": "string" },
    "imports": {
      "type": "array",
      "description": "Other *.pkt.yml files, relative to this file",
      "items": { "type": "string", "minLength": 1 }
    },
    "enums": {
      "type": "object",
      "description": "Named value tables",
      "propertyNames": { "$ref": "#/$defs/name" },
      "additionalProperties": { "$ref": "#/$defs/enum" }
    },
    "packetFormats": {
      "type": "array",
      "items": { "$ref": "#/$defs/packetFormat" }
    }
  },
  "$defs": {
    "name": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
    "intKey": { "type": "string", "pattern": "^(0[xX][0-9A-Fa-f_]+|0[bB][01_]+|[0-9_]+)$" },
    "enumValue": {
      "anyOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name"],
          "properties": { "name": { "type": "string", "minLength": 1 }, "description": { "type": "string" } }
        }
      ]
    },
    "enumValues": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/intKey" },
      "additionalProperties": { "$ref": "#/$defs/enumValue" }
    },
    "enum": {
      "anyOf": [
        { "$ref": "#/$defs/enumValues" },
        {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": { "^x-": {} },
          "required": ["values"],
          "properties": {
            "description": { "type": "string" },
            "flags": { "type": "boolean", "default": false, "description": "Bit set: each value is one bit" },
            "values": { "$ref": "#/$defs/enumValues" }
          }
        }
      ]
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "min": { "type": "integer" }, "max": { "type": "integer" }, "const": { "type": "integer" } }
    },
    "array": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count"],
      "properties": { "count": { "type": "integer", "minimum": 1 }, "stride": { "type": "integer", "minimum": 1 } }
    },
    "fieldType": {
      "type": "string",
      "description": "uint (default), int, bool, enum, bytes, reserved. Unknown types decode as uint.",
      "examples": ["uint", "int", "bool", "enum", "bytes", "reserved"]
    },
    "fieldDetail": {
      "description": "Keys a refine patch may set",
      "type": "object",
      "properties": {
        "description": { "type": "string" },
        "type": { "$ref": "#/$defs/fieldType" },
        "enum": { "$ref": "#/$defs/name" },
        "enumeratedValues": { "$ref": "#/$defs/enumValues" },
        "unit": { "type": "string" },
        "scale": { "type": "number" },
        "offsetValue": { "type": "number" },
        "constraints": { "$ref": "#/$defs/constraints" },
        "fields": { "type": "array", "items": { "$ref": "#/$defs/field" } }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": { "^x-": {} },
      "required": ["name"],
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "bits": { "type": "string", "pattern": "^\\[\\s*[0-9]+\\s*(:\\s*[0-9]+\\s*)?\\]$" },
        "offset": { "type": "integer", "minimum": 0 },
        "width": { "type": "integer", "minimum": 1 },
        "description": { "type": "string" },
        "type": { "$ref": "#/$defs/fieldType" },
        "enum": { "$ref": "#/$defs/name" },
        "enumeratedValues": { "$ref": "#/$defs/enumValues" },
        "unit": { "type": "string" },
        "scale": { "type": "number" },
        "offsetValue": { "type": "number" },
        "fields": { "type": "array", "items": { "$ref": "#/$defs/field" } },
        "format": { "$ref": "#/$defs/name", "description": "Single-beat format whose data fields fill this field" },
        "array": { "$ref": "#/$defs/array" },
        "constraints": { "$ref": "#/$defs/constraints" }
      }
    },
    "signals": {
      "type": "object",
      "description": "Fields per signal: 'data' (= TDATA / data) or a logical port name of the bus definition",
      "additionalProperties": { "type": "array", "items": { "$ref": "#/$defs/field" } }
    },
    "count": {
      "anyOf": [
        { "type": "integer", "minimum": 0 },
        { "const": "untilLast" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["field"],
          "properties": {
            "field": { "type": "string", "minLength": 1 },
            "perBeat": { "type": "integer", "minimum": 1, "default": 1 },
            "add": { "type": "integer", "default": 0 }
          }
        }
      ]
    },
    "beat": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": { "^x-": {} },
      "required": ["name"],
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "description": { "type": "string" },
        "count": { "$ref": "#/$defs/count" },
        "signals": { "$ref": "#/$defs/signals" }
      }
    },
    "packetFormat": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": { "^x-": {} },
      "required": ["name"],
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "description": { "type": "string" },
        "busTypes": { "type": "array", "items": { "type": "string" } },
        "dataWidth": { "type": "integer", "minimum": 1 },
        "beats": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/beat" } },
        "extends": { "$ref": "#/$defs/name" },
        "refine": {
          "type": "object",
          "description": "Field path of the base -> additions",
          "additionalProperties": {
            "allOf": [
              { "$ref": "#/$defs/fieldDetail" },
              {
                "propertyNames": {
                  "enum": ["description", "type", "enum", "enumeratedValues", "unit", "scale", "offsetValue", "constraints", "fields"]
                }
              }
            ]
          }
        }
      },
      "anyOf": [
        { "required": ["extends"], "not": { "anyOf": [{ "required": ["beats"] }, { "required": ["dataWidth"] }] } },
        { "required": ["dataWidth", "beats"], "not": { "anyOf": [{ "required": ["extends"] }, { "required": ["refine"] }] } }
      ]
    }
  }
}
